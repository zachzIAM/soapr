#' SOAP Client Class
#' @description
#' R6 class for interacting with the SOAP service.
#' @importFrom R6 R6Class
#' @export
Client <- R6::R6Class(
  "Client",
  public = list(
    #' @field url The service endpoint URL.
    url = NULL,
    #' @field handle The httr handle.
    handle = NULL,
    #' @field headers List of SOAP headers.
    headers = list(),
    #' @field config List of httr configuration options.
    config = list(),
    #' @field transport Custom transport function.
    transport = NULL,
    #' @field types Factory for creating complex types.
    types = NULL,
    #' @field port_def The definition of the current port.
    port_def = NULL,
    #' @field service_name The name of the selected service.
    service_name = NULL,
    #' @field port_name The name of the selected port.
    port_name = NULL,

    #' @description
    #' Initialize the client.
    #' @param url The service endpoint URL.
    #' @param service The service name to use. defaults to the first available.
    #' @param port The port name to use. defaults to the first available.
    #' @param config A list of httr configuration options.
    #' @param transport A custom transport function.
    initialize = function(url = NULL, service = NULL, port = NULL, config = list(), transport = NULL) {
      services_meta <- {{{services_meta}}}

      # Select Service
      if (is.null(service)) {
        self$service_name <- names(services_meta)[1]
      } else {
        if (!service %in% names(services_meta)) stop("Service not found")
        self$service_name <- service
      }
      
      service_def <- services_meta[[self$service_name]]
      
      # Select Port
      if (is.null(port)) {
        self$port_name <- names(service_def$ports)[1]
      } else {
         if (!port %in% names(service_def$ports)) stop("Port not found")
         self$port_name <- port
      }
      
      self$port_def <- service_def$ports[[self$port_name]]

      if (is.null(url)) url <- self$port_def$location
      self$url <- url
      self$handle <- httr::handle(url)
      self$config <- config
      self$transport <- transport
      self$types <- TypeFactory$new()
    },

    #' @description
    #' Add a SOAP header.
    #' @param header An xml_node representing the header.
    add_header = function(header) {
      self$headers <- c(self$headers, list(header))
      invisible(self)
    },
    {{#operations}}

    #' @description {{{doc}}}
    {{{param_docs_str}}}
    {{{name}}} = function({{{args}}}) {
      op_name <- "{{{name}}}"
      op_meta <- self$port_def$operations[[op_name]]
      if (is.null(op_meta)) {
          stop(sprintf("Operation '%s' is not supported by port '%s'", op_name, self$port_name))
      }
      action <- op_meta$action
      
      {{#arg_validations}}
      {{{.}}}
      {{/arg_validations}}
      args <- list()
      {{#arg_assignments}}
      {{{.}}}
      {{/arg_assignments}}

      soap_version <- if (!is.null(self$port_def$soap_version)) self$port_def$soap_version else "1.1"

      # Construct Envelope
      envelope <- xml2::xml_new_root("soap:Envelope",
        "xmlns:soap" = get_soap_envelope_ns(soap_version),
        "xmlns:xsi" = "http://www.w3.org/2001/XMLSchema-instance",
        "xmlns:xsd" = "http://www.w3.org/2001/XMLSchema",
        "xmlns:tns" = "{{{tns}}}"
      )

      # Add Headers
      if (length(self$headers) > 0) {
        header_node <- xml2::xml_add_child(envelope, "soap:Header")
        for (header in self$headers) {
          xml2::xml_add_child(header_node, header)
        }
      }

      body <- xml2::xml_add_child(envelope, "soap:Body")
      op_node <- xml2::xml_add_child(body, "{{{input_element}}}")
      xml2::xml_attr(op_node, "xmlns") <- "{{{tns}}}"

      for (arg_name in names(args)) {
        build_xml_node(op_node, arg_name, args[[arg_name]])
      }

      ct <- build_soap_content_type(action = action, soap_version = soap_version)
      if (!is.null(self$transport)) {
        req_config <- build_transport_config(self$config, action = action, soap_version = soap_version)
        response <- self$transport(self$url, action, as.character(envelope), req_config, self$handle)
      } else if (identical(soap_version, "1.2")) {
        response <- httr::POST(
          url = self$url,
          handle = self$handle,
          httr::content_type(ct),
          body = as.character(envelope),
          config = self$config
        )
      } else {
        response <- httr::POST(
          url = self$url,
          handle = self$handle,
          httr::add_headers(SOAPAction = action),
          httr::content_type(ct),
          body = as.character(envelope),
          config = self$config
        )
      }
      handle_fault(response)
      content <- deserialize_response(response)
      extract_response_object(content, get_schema(), self$types)
    }{{^last}},{{/last}}
    {{/operations}}
  )
)

#' Create Client
#' @param url The service endpoint URL. Defaults to the WSDL location.
#' @param service The service name to use. Defaults to first available.
#' @param port The port name to use. Defaults to first available. 
#' @param config A list of httr configuration options (e.g., authentication).
#' @param transport A custom transport function for mocking. Defaults to NULL.
#' @return A Client object.
#' @export
new_client <- function(url = NULL, service = NULL, port = NULL, config = list(), transport = NULL) {
  Client$new(url = url, service = service, port = port, config = config, transport = transport)
}
