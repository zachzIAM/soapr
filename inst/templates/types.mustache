#' Type Factory
#' @description Factory for creating SOAP complex types.
#' @importFrom R6 R6Class
#' @export
TypeFactory <- R6::R6Class(
  "TypeFactory",
  public = list(

    {{#types}}
    #' @description {{{doc}}}
    {{#param_docs}}
    #' @param {{{.}}}
    {{/param_docs}}
    {{{name}}} = function({{{args}}}) {
      {{{validation_code}}}
      obj <- {{{body}}}
      {{#is_complex}}
      class(obj) <- c("soap_object", "list")
      {{/is_complex}}
      attr(obj, "soap_type") <- "{{{name}}}"
      {{#has_attrs}}
      attr(obj, "soap_attrs") <- {{{attr_names}}}
      {{/has_attrs}}
      return(obj)
    }{{^last}},{{/last}}

    {{/types}}
  )
)
